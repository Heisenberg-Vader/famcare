rules_version = '2';

// CarePal Daily Care access rules (CLAUDE.md section 6).
// Role comes from the custom claim set by the seed script; patient membership comes from
// patients/{pid}.nurseIds / familyIds. Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function patientData(pid) {
      return get(/databases/$(database)/documents/patients/$(pid)).data;
    }

    function isNurseOf(pid) {
      return hasRole('nurse') && request.auth.uid in patientData(pid).nurseIds;
    }

    function isFamilyOf(pid) {
      return hasRole('family') && request.auth.uid in patientData(pid).familyIds;
    }

    function canReadPatient(pid) {
      return isNurseOf(pid) || isFamilyOf(pid);
    }

    function allowedType(t) {
      return t in ['vitals', 'meal', 'water', 'medication', 'activity', 'mood', 'observation'];
    }

    function validDateKey(k) {
      return k is string && k.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /patients/{pid} {
      // Checked against the document itself so that list queries filtered with
      // where('nurseIds'|'familyIds', 'array-contains', uid) are allowed.
      allow read: if (hasRole('nurse') && request.auth.uid in resource.data.nurseIds)
                  || (hasRole('family') && request.auth.uid in resource.data.familyIds);
      allow write: if false;

      match /medications/{medId} {
        allow read: if canReadPatient(pid);
        allow write: if false;
      }

      match /entries/{entryId} {
        // Families read the full history. Nurses only read today and yesterday (IST), so a
        // nurse device never holds more than two days of entries. 50 h covers the start of
        // yesterday at any time of today plus clock skew. Queries must bound `at` to pass.
        allow read: if isFamilyOf(pid)
          || (isNurseOf(pid) && resource.data.at >= request.time - duration.value(50, 'h'));

        // createdAt/updatedAt must be serverTimestamp() so the 12 h edit window cannot be faked.
        // `at` may be backdated but not more than 10 minutes into the future.
        allow create: if isNurseOf(pid)
          && request.resource.data.nurseId == request.auth.uid
          && allowedType(request.resource.data.type)
          && validDateKey(request.resource.data.dateKey)
          && request.resource.data.at is timestamp
          && request.resource.data.at <= request.time + duration.value(10, 'm')
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isNurseOf(pid)
          && resource.data.nurseId == request.auth.uid
          && request.time < resource.data.createdAt + duration.value(12, 'h')
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['nurseId', 'type', 'createdAt'])
          && validDateKey(request.resource.data.dateKey)
          && request.resource.data.at is timestamp
          && request.resource.data.at <= request.time + duration.value(10, 'm')
          && request.resource.data.updatedAt == request.time;

        // Care records are append-only; corrections are edits.
        allow delete: if false;
      }
    }
  }
}
